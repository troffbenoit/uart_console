module alchitry_top (
    input clk,              // 100MHz clock
    input rst_n,            // reset button (active low)
    output led[8],          // 8 user controllable LEDs
    input usb_rx,           // USB->Serial input
    output usb_tx           // USB->Serial output
) {
    
    sig rst
    
    .clk(clk) {
        reset_conditioner reset_cond
        
        #BAUD(115_200), #CLK_FREQ(100_000_000) {
            uart_rx rx
            uart_tx tx
        }
        
        .rst(rst) {
            dff tx_data[8]
            dff tx_pending
            dff got_line
            dff newline_pending
        }
    }
    
    always {
        reset_cond.in = ~rst_n
        rst = reset_cond.out
        
        rx.rst = rst
        tx.rst = rst
        
        led = 8h00
        led[0] = got_line.q
        
        // UART input
        rx.rx = usb_rx
        
        // Default transmitter inputs
        tx.data = tx_data.q
        tx.new_data = 0
        
        // When RX gets a character, save it
        if (rx.new_data) {
            if (rx.data == 8h0D) {
                got_line.d = 1
                tx_data.d = 8h0D
                tx_pending.d = 1
                newline_pending.d = 1
            } else if (rx.data != 8h0A){
                tx_data.d = rx.data
                tx_pending.d = 1
            }
        }
        
        // When TX is ready, send saved character
        if (tx_pending.q && !tx.busy) {
            tx.new_data = 1
            tx_pending.d = 0
            if (newline_pending.q){
                tx_data.d = 8h0A
                tx_pending.d = 1
                newline_pending.d = 0
            }
        }
        
        usb_tx = tx.tx
    }
}